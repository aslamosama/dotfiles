#!/usr/bin/env sh

dmenu_command="dmenu -i"

menu=$(
  cat <<EOF
󰀻  Apps            | dmenu_run -i -p "dmenu_run:"
  Games           | game-launcher
  Cycle Wall      | themecycle
  Themes          | themeflip
󰋊  Mount           | mounter
󱁌  Unmount         | unmounter
󰌹  Handler         | dmenuhandler
  Screenshot      | maimpick
  Record          | dmenurecord
󰌌  Keybinds        | keybinds
󰄄  Camera          | bash -c 'mpv av://v4l2:/dev/video0 --demuxer-lavf-format=video4linux2 --demuxer-lavf-o-set=input_format=mjpeg --untimed --no-cache --no-config --no-osc --no-input-default-bindings --profile=low-latency --input-conf=/dev/null --title=webcam'
  Web Search      | dmenu_web
  NerdFont Icons  | dmenunerdsymbols
󱡫  Dual Audio      | dualaudio
󰉦  Bar colors      | bar_colors_toggle
  Kill            | processkill
EOF
)

options=$(echo "$menu" | cut -d '|' -f1 | sed 's/[[:space:]]*$//')
selected_option=$(echo "$options" | eval "$dmenu_command")
if [ -n "$selected_option" ]; then
  action=$(echo "$menu" | awk -F'|' -v option="$selected_option" '$1 ~ option {print $2}')
  [ -n "$action" ] && eval "$action"
fi
