#!/usr/bin/env bash

SCRIPTDIR="${HOME}/.local/bin/magick-scripts"
SESSION="magickmenu"

command -v tmux >/dev/null 2>&1 || {
  echo "install tmux"
  exit 1
}
command -v fzf >/dev/null 2>&1 || {
  echo "install fzf"
  exit 1
}

if [[ ! -d "$SCRIPTDIR" ]]; then
  echo "directory not found: $SCRIPTDIR"
  exit 1
fi

if [[ -n "$1" ]]; then
  candidate="$SCRIPTDIR/$1"
  if [[ ! -x "$candidate" ]]; then
    echo "not executable: $candidate"
    exit 1
  fi
  script="$candidate"
else
  mapfile -t files < <(find -L "$SCRIPTDIR" -maxdepth 1 -type f -executable -printf "%f\n" | sort)
  [[ ${#files[@]} -gt 0 ]] || {
    echo "no executables in $SCRIPTDIR"
    exit 1
  }
  pick=$(printf "%s\n" "${files[@]}" |
    fzf --prompt="Select script: " --preview="$SCRIPTDIR/{} -help 2>&1") || exit 1
  script="$SCRIPTDIR/$pick"
fi

tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"
tmux new-session -d -s "$SESSION" -n "main"
tmux split-window -h -t "$SESSION:main"
tmux send-keys -t "$SESSION:main.0" "$script -h |& less" C-m
tmux send-keys -t "$SESSION:main.1" "$script "
tmux select-pane -t "$SESSION:main.1"
tmux attach -t "$SESSION:main"
